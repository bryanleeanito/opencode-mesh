# OpenCode Mesh Environment Variables
# Copy ke .env dan isi dengan value sebenarnya

# SSH keys (for sync)
TABLET_SSH_KEY=/home/user/.ssh/id_ed25519
SCHOOL_SSH_KEY=/home/user/.ssh/id_ed25519
WINDOWS_SSH_KEY=/home/user/.ssh/id_ed25519

# API keys (for tools)
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
GITHUB_TOKEN=

# Sync settings
MESH_AUTO_PULL=true
MESH_AUTO_PUSH=false
MESH_SYNC_INTERVAL=300

# Security
MESH_ENCRYPT_STATE=true
MESH_REDACT_OUTPUT=true
